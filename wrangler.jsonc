// Cloudflare Worker for study.kaivon.app: the web app (dist), Python for the code editor
// (/pyodide/, kept in R2) and the room server for studying together (worker/: /api/rooms/*, one
// StudyRoom Durable Object per room, video through Cloudflare Realtime). Chip's brain is the
// chip-study edge function on Utopia's Supabase project; rooms reach the database through its
// study-rooms function. Contract: docs/rooms.md.
// Deploy: npm run deploy (after node scripts/env.mjs). Rooms also need these, set once as
// secrets (never in this file) by .tools/go-live-rooms.sh:
//   SUPABASE_ANON_KEY     the app's public publishable key (VITE_SUPABASE_ANON_KEY)
//   ROOM_SERVER_SECRET    the same value as the study-rooms function's; also signs tickets
//   REALTIME_APP_ID, REALTIME_APP_SECRET    Cloudflare Realtime > SFU app
//   TURN_KEY_ID, TURN_KEY_API_TOKEN         Cloudflare Realtime > TURN key
// Until they're set, /api/rooms answers 503 not_configured; the app itself is unaffected.
{
  "name": "chip-study-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pyodide/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "StudyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudyRoom"] }],
  // Python for the code editor, kept here after its first download (worker/pyodide.ts). The
  // bucket is made once by .tools/go-live-rooms.sh.
  "r2_buckets": [{ "binding": "PYODIDE", "bucket_name": "chip-study-pyodide" }],
  "vars": {
    "SUPABASE_URL": "https://atrgasakfnmixhictynh.supabase.co",
    // Rooms (Durable Objects) run and keep their state only in the EU, like the rest of Chip
    // Study's stored data (Ireland). Changing it later starts every room afresh.
    "ROOMS_JURISDICTION": "eu",
    "ROOM_SERVICE_URL": "https://atrgasakfnmixhictynh.supabase.co/functions/v1/study-rooms"
  },
  "routes": [{ "pattern": "study.kaivon.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
